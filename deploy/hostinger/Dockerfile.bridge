# Slim UI-bridge image for Hostinger (no torch / desktop automation)
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/hostinger/requirements-bridge.txt /tmp/requirements-bridge.txt
RUN pip install --no-cache-dir -r /tmp/requirements-bridge.txt

# Application code only (keep image lean)
COPY src ./src
COPY services ./services

ENV PYTHONUNBUFFERED=1
ENV VORTEX_ENV=production
ENV PYTHONPATH=/app
ENV JARVIS_SHARED_DIR=/app/Jarvis_Shared

# /app/data holds bridge.db (named volume jarvis_bridge_data)
RUN mkdir -p /app/logs /app/Jarvis_Outputs /app/Jarvis_Shared \
    /app/conversations /app/chroma_db /app/pretrained_models /app/backups /app/data

# 5001: the public API (nginx /vortex/, published on the host as 5101). 5002: the internal listener for the agent
# containers (C-116, K-48 v4); it opens when JARVIS_ROLE=bridge and compose never publishes it.
EXPOSE 5001 5002

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:5001/health || exit 1

CMD ["python", "-m", "src.core.ui_bridge"]
