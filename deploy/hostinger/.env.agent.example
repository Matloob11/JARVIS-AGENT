# deploy/hostinger/.env.agent: the env_file of the VPS brain containers jarvis-agent and jarvis-agent-svc
# (plan C-126/C-127, contracts K-47 and K-75). Key names only; never commit the real file.
# On the VPS it sits next to docker-compose.yml, root 600; compose reads it and passes the values to the two
# containers, it is never mounted. scripts/ops/push_agent_env.py (C-127) copies the allow-listed values from the PC
# root .env over ssh stdin and the main LiveKit pair from the compose .env next to it; push_agent_env.py --keys runs
# scripts/ops/gen_desktop_keys.py --role agent in a one-off agent container, so the agent's link key is made on the
# VPS. Values are never printed; the tools compare them by HMAC digest only. Non-secret settings (role, brain, URLs, worker options) are in docker-compose.yml, not here.

# AI, search and image providers
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
POLLINATIONS_TOKEN=
WEATHER_API_KEY=
GOOGLE_SEARCH_API_KEY=
SEARCH_ENGINE_ID=
TAVILY_API_KEY=

# Email (the owner's own account)
EMAIL_USER=
EMAIL_APP_PASSWORD=

# SIM lookup (K-34, the authorized provider only)
SIM_LOOKUP_API_URL=
SIM_LOOKUP_API_KEY=

# Memory encryption: the same value as the PC (compared by HMAC digest only, never shown)
JARVIS_ENCRYPTION_KEY=

# LiveKit (the agent worker registers with ws://jarvis-livekit:7880): the main pair, copied from the compose .env
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Desktop Link (K-70): the agent's private key is made on the VPS; the others are public keys
DESKTOP_AGENT_SIGNING_KEY=
DESKTOP_AGENT_PUBLIC_KEY=
DESKTOP_PC_PUBLIC_KEY=

# The daily snapshot is sealed to this PC public key (K-77)
BACKUP_RECIPIENT_PUBLIC_KEY=

# The agent's bridge notify client signs every /notify (C-NOTIFY-1), also on the internal :5002 listener, and needs
# these two (the same values as bridge.env, K-47 v36; push_agent_env.py checks that by digest) or the legacy
# VORTEX_SECURITY_TOKEN; without them its notifies are dropped.
AGENT_TOKEN=
BRIDGE_HMAC_SECRET=

# Tools-info switches (K-35), the same names as the PC root .env
JARVIS_TEXT_MODEL=
JARVIS_VISION_MODEL=
JARVIS_GROQ_TEXT_MODEL=
JARVIS_GROQ_VISION_MODEL=
JARVIS_OPENROUTER_MODEL=
JARVIS_IMAGE_MODEL=
JARVIS_IMAGE_PROVIDER=
TAVILY_SEARCH_DEPTH=
SMTP_HOST=
SMTP_PORT=
JARVIS_DOC_DIRS=
JARVIS_RAG_WARM_DELAY_S=
JARVIS_FRAME_MAX_AGE_S=
JARVIS_SELF_REPAIR_APPLY=
SIM_SOURCE=
SIM_LOOKUP_DAILY_LIMIT=
SIM_LOOKUP_SHOW_ADDRESS=
