# JARVIS VPS (Docker project jarvis) env: key names only
# Copy to .env next to this file and fill real values. Never commit the real .env.
# Since the V2b secrets split (plan C-127, K-47 v4) this file holds what docker-compose.yml interpolates and the
# brain switch's names; no AI, search, email or SIM key, no JARVIS_ENCRYPTION_KEY, no CONTROLLER_TOKEN: those live in
# .env.agent (names: .env.agent.example) and the PC root .env. scripts/ops/split_bridge_env.py moves an older
# single-file .env to this layout (names only printed); ui-bridge still reads this file until C-18.

VORTEX_ENV=
LOG_LEVEL=
LOG_FILE=
USER_NAME=
USER_CITY=
UI_BRIDGE_URL=
ALLOWED_ORIGINS=
VITE_VORTEX_URL=
VITE_VORTEX_SECURITY_TOKEN=
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=
JARVIS_ROOM_NAME=
JARVIS_SHARED_DIR=
# Interpolated by docker-compose.yml: the LiveKit pair (LIVEKIT_KEYS) and the legacy token (the frontend build arg,
# until OP-21). bridge.env holds its own copies; the rotation tools change every copy.
VORTEX_SECURITY_TOKEN=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The PC fallback's own LiveKit pair (C-127 step 6), written by scripts/ops/livekit_pc_pair.py create and interpolated
# only once the V6 LiveKit window adds it to LIVEKIT_KEYS (deploy/hostinger/RUNBOOK.md):
# LIVEKIT_PC_API_KEY=
# LIVEKIT_PC_API_SECRET=

# bridge.env, next to this file: the ui-bridge's second env_file (root 600, gitignored; C-ENV-1). Optional
# for compose, so the bridge also starts without it; its values win over this file. Create or complete it
# from the PC with 'scripts/ops/gen_secrets.py --vps' (values go over ssh stdin and are never printed); the split
# (scripts/ops/split_bridge_env.py) adds the bridge settings this file held, push_agent_env.py --keys the public keys:
# AGENT_TOKEN=
# BRIDGE_HMAC_SECRET=
# SESSION_JWT_SECRET=
# OWNER_PASSWORD_HASH=
# OWNER_TOTP_SECRET=
# OWNER_RECOVERY_HASHES=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# VORTEX_SECURITY_TOKEN=
# LEGACY_TOKEN_AUTH=1
# BRIDGE_EVENT_RETENTION_DAYS=0
# DESKTOP_AGENT_PUBLIC_KEY=
# DESKTOP_PC_PUBLIC_KEY=
# LOG_LEVEL=
# LOG_FILE=
# Set by the compose file itself (not env files): JARVIS_ROLE=bridge, ALLOWED_ORIGINS, COOKIE_PATH,
# COOKIE_SECURE, BRIDGE_DB_PATH.

# VPS brain switch (K-72): 'agent_ctl brain vps|pc' switches it (in place; other lines kept). docker-compose.yml
# reads JARVIS_BRAIN as ${JARVIS_BRAIN:?...} (plan C-126), so every compose command refuses to run while it is missing:
# set JARVIS_BRAIN=pc (today's brain) once, before the first deploy of that compose file. COMPOSE_PROFILES follows it
# (vps-brain in vps mode, empty in pc mode): with vps-brain a plain 'up -d' also starts jarvis-agent and
# jarvis-agent-svc. JARVIS_PC_AGENT_NAME: the PC fallback worker's name for the bridge (default jarvis-pc).
JARVIS_BRAIN=
COMPOSE_PROFILES=
JARVIS_PC_AGENT_NAME=
# The agent containers' secrets and the SIM lookup settings (K-34) live in .env.agent next to this file (names:
# .env.agent.example), never here.
