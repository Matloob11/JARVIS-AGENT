# JARVIS VPS (Docker project jarvis) env: key names only
# Copy to .env next to this file and fill real values. Never commit the real .env.

VORTEX_ENV=
LOG_LEVEL=
LOG_FILE=
USER_NAME=
USER_CITY=
VORTEX_SECURITY_TOKEN=
CONTROLLER_TOKEN=
JARVIS_ENCRYPTION_KEY=
UI_BRIDGE_URL=
ALLOWED_ORIGINS=
VITE_VORTEX_URL=
VITE_VORTEX_SECURITY_TOKEN=
GOOGLE_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PUBLIC_URL=
JARVIS_ROOM_NAME=
JARVIS_SHARED_DIR=
WEATHER_API_KEY=
GOOGLE_SEARCH_API_KEY=
SEARCH_ENGINE_ID=
TAVILY_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
EMAIL_USER=
EMAIL_APP_PASSWORD=

# bridge.env, next to this file: the ui-bridge's second env_file (root 600, gitignored; C-ENV-1). Optional
# for compose, so the bridge also starts without it; its values win over this file. Create or complete it
# from the PC with 'scripts/ops/gen_secrets.py --vps' (values go over ssh stdin and are never printed):
# AGENT_TOKEN=
# BRIDGE_HMAC_SECRET=
# SESSION_JWT_SECRET=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# VORTEX_SECURITY_TOKEN=
# LEGACY_TOKEN_AUTH=1
# BRIDGE_EVENT_RETENTION_DAYS=0
# Set by the compose file itself (not env files): JARVIS_ROLE=bridge, ALLOWED_ORIGINS, COOKIE_PATH,
# COOKIE_SECURE, BRIDGE_DB_PATH.

# SIM lookup (K-34, authorized provider only). Real values live only in a git-ignored .env / .env.agent.
SIM_SOURCE=auto                 # 'none' forces the privacy-safe blocked mode
SIM_LOOKUP_API_URL=             # base URL of the authorized provider (no path)
SIM_LOOKUP_API_KEY=             # Bearer token for the provider
SIM_LOOKUP_SHOW_ADDRESS=0       # 1 to include address in results
SIM_LOOKUP_DAILY_LIMIT=20       # successful lookups per day
