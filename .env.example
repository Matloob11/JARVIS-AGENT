# JARVIS Agent environment template
# Copy this file to .env locally. Never commit .env.

# Runtime
VORTEX_ENV=development
LOG_LEVEL=INFO
LOG_FILE=logs/jarvis.log
# Level of LOG_FILE (one rotating file, 10 MB x 5); the console keeps LOG_LEVEL (K-29, C-64)
LOG_FILE_LEVEL=INFO
# What reaches the UI log panel: this level and up, plus the INFO lines of the loggers listed below
# (UI_LOG_LEVEL=INFO forwards every INFO line; UI_LOG_INFO_ALLOW= empty forwards none) (K-40, C-64)
UI_LOG_LEVEL=WARNING
UI_LOG_INFO_ALLOW=AGENT-RUNNER,JARVIS-CORE,PLUGIN-MANAGER,JARVIS-LOOPS
# Bridge store bounds (C-64): days of event/log rows to keep (0 = forever) and the most log-feed rows kept
# even at retention 0 (0 = no cap; the UI only ever shows the newest lines)
BRIDGE_EVENT_RETENTION_DAYS=0
BRIDGE_LOG_MAX_ROWS=20000
USER_NAME=User
USER_CITY=Lahore

# Security
# Generate strong random values for these before running the app.
VORTEX_SECURITY_TOKEN=replace_with_strong_random_token
CONTROLLER_TOKEN=replace_with_strong_random_controller_token
JARVIS_ENCRYPTION_KEY=replace_with_fernet_key

# Runtime role of this process (K-72): agent (the PC worker) | svc | bridge | desktop
JARVIS_ROLE=agent
# Agent link v2 (C-SOCK-1 / C-NOTIFY-1): the agent's own bridge token and the notify HMAC key, the same
# values as in the VPS bridge.env. Create both with 'scripts/ops/gen_secrets.py --pc' and change one with
# 'scripts/ops/rotate_env_secret.py' (never paste a value here). VORTEX_SECURITY_TOKEN stays the legacy
# token until it is switched off (LEGACY_TOKEN_AUTH=0 on the bridge).
AGENT_TOKEN=
BRIDGE_HMAC_SECRET=

# UI bridge
UI_BRIDGE_URL=http://127.0.0.1:5001
# Browser origins a bridge started on this PC accepts (env only; unset or empty = the two Vite dev origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# A bridge started on this PC: legacy token on/off and its SQLite store
# LEGACY_TOKEN_AUTH=1
# BRIDGE_DB_PATH=<project_root>/data/bridge.db

# Frontend/Vite
VITE_VORTEX_URL=http://localhost:5001
VITE_VORTEX_SECURITY_TOKEN=replace_with_same_value_as_vortex_security_token

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret
# The lk.agent.name this PC's worker registers (K-69/K-72 v9). Unset or empty = automatic dispatch (''); from C-23
# phase 3 the PC root .env says jarvis-pc. The VPS containers default to jarvis.
# JARVIS_AGENT_NAME=jarvis-pc
# Bridge / VPS only (C-23, K-44/K-47 v9), never needed on the PC:
# AGENT_DISPATCH_MODE=always|on_demand|observe   (unset: always with the PC brain, on_demand with the VPS brain)
# JARVIS_PC_AGENT_NAME=jarvis-pc                 (the PC brain's agent name the bridge accepts besides '')

# PC worker LiveKit link (C-136, K-53/K-69). The worker writes run/agent_link.json and asks agent_ctl for a
# fresh worker when its LiveKit link stays lost while LiveKit answers again. 0, false, no or off turns those
# automatic restarts off; the state file and the LIVEKIT LINK log lines stay.
# JARVIS_LINK_RECOVERY=1
# JARVIS_LINK_RECOVERIES is internal: only that recovery sets it, for the worker it starts. Never set it here.
# Worker prewarm (C-32, K-69): seconds the executor may take to prewarm (plugin discovery + VAD + city),
# idle executors kept warm (the PC keeps 1; the VPS agent container says 2 — K-75), and the load above
# which LiveKit marks this worker full ('inf' keeps the owner's only worker dispatchable; the PC also
# reports a constant load 0.0 — K-44). A commented line shows the code default.
# JARVIS_PREWARM_TIMEOUT=120
# JARVIS_IDLE_PROCS=1
# JARVIS_LOAD_THRESHOLD=inf

# Google Gemini and cloud speech
GOOGLE_API_KEY=replace_with_google_api_key

# Search providers (Google Programmable Search / Custom Search JSON API)
# cx from: https://cse.google.com/cse.js?cx=YOUR_CX
GOOGLE_SEARCH_API_KEY=
SEARCH_ENGINE_ID=
TAVILY_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# Weather
WEATHER_API_KEY=
OPENWEATHER_API_KEY=

# Email, optional
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Local workspace
JARVIS_SHARED_DIR=~/Jarvis_Shared

# Desktop tools (contract K-15). A commented line shows the code default; uncomment it only to change it.
# Lists are ';'-separated; ~ and %VARS% are expanded; <project_root> stands for this repo folder.
# D:/ is added to the media dirs, the open roots and the file server root only when a D: drive exists.
# JARVIS_OUTPUTS_DIR=<project_root>/Jarvis_Outputs
# JARVIS_MEDIA_DIRS=~/Music;~/Videos;~/Downloads;~/Desktop;~/Documents;~/Jarvis_Shared
# JARVIS_OPEN_ROOTS=~/Desktop;~/Documents;~/Downloads;~/Music;~/Videos;<project_root>/Jarvis_Outputs;~/Jarvis_Shared
# JARVIS_FILE_SERVER_ROOT=~/Jarvis_Shared
# JARVIS_FILE_SERVER_PORT=8000
# JARVIS_FILE_SERVER_TTL_MIN=30
# JARVIS_DESKTOP_CONTROL=1
# JARVIS_CLIPBOARD_HELPER=1
# JARVIS_CLIPBOARD_SPEAK=0
# JARVIS_CONFIRM_TIMEOUT_S=60
# JARVIS_VOICE_CONFIRM_HIGH=0
# Empty means auto-detect: browser install folders / App Paths, the PinchTab npm shim, ffmpeg on PATH or C:/ffmpeg/bin.
# JARVIS_CHROME_PATH=
# JARVIS_EDGE_PATH=
# JARVIS_PLAYWRIGHT_CHANNEL=chrome
# PINCHTAB_URL=http://127.0.0.1:9867
# PINCHTAB_BIN=
# PINCHTAB_AUTOSTART=1
# PINCHTAB_ALLOWED_DOMAINS=*
# FFMPEG_DIR=
# WHATSAPP_APP_ID=5319275A.WhatsAppDesktop_cv1g1gvanyjgm!App
# WHATSAPP_CONTACTS_FILE=<project_root>/data/whatsapp_contacts.json
# JARVIS_CV_PATH=
# Secret: create it with 'scripts/ops/env_set.py --secret PINCHTAB_TOKEN' (never paste a value here).
PINCHTAB_TOKEN=

# SIM lookup (K-34, authorized provider only). Real values live only in a git-ignored .env / .env.agent.
SIM_SOURCE=auto                 # 'none' forces the privacy-safe blocked mode
SIM_LOOKUP_API_URL=             # base URL of the authorized provider (no path)
SIM_LOOKUP_API_KEY=             # Bearer token for the provider
SIM_LOOKUP_SHOW_ADDRESS=0       # 1 to include address in results
SIM_LOOKUP_DAILY_LIMIT=20       # successful lookups per day
# Tools-info keys (C-46, contract K-35): scripts/ops/env_defaults.py
JARVIS_TEXT_MODEL=gemini-3.5-flash
JARVIS_VISION_MODEL=gemini-3.8-flash
JARVIS_GROQ_TEXT_MODEL=openai/gpt-oss-120b
JARVIS_GROQ_VISION_MODEL=qwen/qwen3.8-27b
JARVIS_OPENROUTER_MODEL=openrouter/free
JARVIS_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
JARVIS_IMAGE_PROVIDER=auto
POLLINATIONS_TOKEN=
TAVILY_SEARCH_DEPTH=advanced
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
JARVIS_DOC_DIRS=
JARVIS_RAG_WARM_DELAY_S=120
JARVIS_FRAME_MAX_AGE_S=10
JARVIS_SELF_REPAIR_APPLY=0
