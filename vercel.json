{
  "version": 2,
  "builds": [
    {
      "src": "stonix_ui/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "installCommand": "npm install",
        "buildCommand": "npm run build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "status": 302,
      "headers": {
        "Location": "https://jarvis.srv1802669.hstgr.cloud/$1"
      }
    }
  ]
}
