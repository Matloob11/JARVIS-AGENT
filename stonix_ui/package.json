{
  "$schema": "https://json.schemastore.org/package",
  "name": "jarvis-anna-neural-interface",
  "version": "1.0.0",
  "description": "JARVIS & ANNA Neural Interface - Advanced AI Desktop Assistant",
  "author": "Matloob11 / J.A.R.V.I.S",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node launcher.js",
    "vite-dev": "vite --no-open --host 127.0.0.1",
    "electron-dev": "concurrently --kill-others \"npm run vite-dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc && vite build",
    "prod-build": "npm run build",
    "prod-serve": "npx serve -s dist -l 5173",
    "prod-run": "SET ELECTRON_IS_DEV=0 && npx concurrently -k \"npm run prod-serve\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-spring/web": "^10.0.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-query": "^5.100.10",
    "@tauri-apps/api": "^2.11.0",
    "@types/leaflet": "^1.9.12",
    "axios": "^1.16.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-hot-toast": "^2.4.1",
    "react-lazily": "^0.9.2",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.15.0",
    "socket.io-client": "^4.7.2",
    "three": "^0.184.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-is-dev": "^3.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10",
    "serve": "^14.2.3"
  },
  "overrides": {
    "minimatch": "^3.1.2",
    "rollup": "^4.0.0",
    "@remix-run/router": "^1.15.3",
    "glob": "^10.4.5"
  },
  "type": "module"
}
